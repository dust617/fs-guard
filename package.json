{
  "name": "fs-guard",
  "version": "0.1.0",
  "description": "pi 工具运行时防护 (Tool Runtime Guard)：读写/执行错误的自动拦截、错误分类与自愈提示，附带破坏性命令与 git 仓库边界防护。面向 pi Coding Agent 的全局扩展，核心逻辑可复用为 CLI。",
  "keywords": [
    "pi",
    "extension",
    "tool-guard",
    "error-classification",
    "filesystem",
    "reliability"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --test tests/core.test.ts",
    "test:smoke": "node tests/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "^1.3.19"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
